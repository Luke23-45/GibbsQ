\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Generalization sweep: improvement ratio (Calibrated UAS $/$ Neural) across load and scale. Ratio ${>}1.0$ indicates the learned policy achieves lower (better) queue length. All 16 cells strictly exceed $1.0$, providing consistent directional evidence. Because all cells reflect the same trained policy, no aggregate significance test is applicable; the 16/16 consistency is itself the evidence. Inflated ratios at low loads (e.g., $1.48$ at $\rho {=}0.50$) reflect small absolute queue denominators rather than large absolute improvements. The anchor load $\rho {=}0.80$ is not included in this sweep; the ablation comparison (Table~\ref {tab:ablation}) shows a ratio of $\approx 1.008$ at $1{\times }$ scale for the anchor load configuration.}}{25}{table.caption.32}\protected@file@percent }
\newlabel{tab:generalize}{{8}{25}{Generalization sweep: improvement ratio (Calibrated UAS $/$ Neural) across load and scale. Ratio ${>}1.0$ indicates the learned policy achieves lower (better) queue length. All 16 cells strictly exceed $1.0$, providing consistent directional evidence. Because all cells reflect the same trained policy, no aggregate significance test is applicable; the 16/16 consistency is itself the evidence. Inflated ratios at low loads (e.g., $1.48$ at $\rho {=}0.50$) reflect small absolute queue denominators rather than large absolute improvements. The anchor load $\rho {=}0.80$ is not included in this sweep; the ablation comparison (Table~\ref {tab:ablation}) shows a ratio of $\approx 1.008$ at $1{\times }$ scale for the anchor load configuration}{table.caption.32}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Absolute generalization contextual values: Mean total queue lengths for the Calibrated UAS baseline (single-replication SSA point estimates per cell, using the Gillespie engine with the anchor service-rate vector scaled by the column multiplier). These values provide approximate magnitude context for interpreting the Table~\ref {tab:generalize} ratios; however, as single-replication estimates, individual cell values carry substantial variance ($\mathrm  {SE} \approx 0.1$--$0.5$ depending on load).}}{25}{table.caption.33}\protected@file@percent }
\newlabel{tab:generalize_abs}{{9}{25}{Absolute generalization contextual values: Mean total queue lengths for the Calibrated UAS baseline (single-replication SSA point estimates per cell, using the Gillespie engine with the anchor service-rate vector scaled by the column multiplier). These values provide approximate magnitude context for interpreting the Table~\ref {tab:generalize} ratios; however, as single-replication estimates, individual cell values carry substantial variance ($\mathrm {SE} \approx 0.1$--$0.5$ depending on load)}{table.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Generalization heatmap} ($N{=}10$, 32 replications per cell). Improvement ratio of Calibrated UAS to Neural policy (ratio ${>}1$ $\Rightarrow $ Neural wins). The strongest advantage ($1.60{\times }$) occurs at $\rho = 0.5$, $2{\times }$ scale.}}{25}{figure.caption.34}\protected@file@percent }
\newlabel{fig:generalize}{{4}{25}{\textbf {Generalization heatmap} ($\Nservers {=}10$, 32 replications per cell). Improvement ratio of Calibrated UAS to Neural policy (ratio ${>}1$ $\Rightarrow $ Neural wins). The strongest advantage ($1.60{\times }$) occurs at $\rho = 0.5$, $2{\times }$ scale}{figure.caption.34}{}}
